# ==========================================================
# NUNCA COMMITEAR EL .env REAL — sólo este .env.example
# ==========================================================

# Entorno
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
REQUEST_TIMEOUT_MS=30000
JSON_BODY_LIMIT=100kb

# CORS — orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173

# JWT (RS256 — claves asimétricas)
# Genera el par con: npm run keys:gen   (deja los archivos en backend/keys/)
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=ironcore-api
JWT_AUDIENCE=ironcore-web

# Cookies (refresh token)
COOKIE_SECURE=false          # true en producción (HTTPS)
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# AWS / DynamoDB
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
# Para DynamoDB Local descomentar:
# DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=gym_

# Rate limit
RATE_LIMIT_WINDOW_MS=900000      # 15 min
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=5            # 5 intentos/15min en /auth/login

# Logging
LOG_LEVEL=info
