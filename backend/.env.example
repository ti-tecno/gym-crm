# ==========================================================
# NUNCA COMMITEAR EL .env REAL — sólo este .env.example
# ==========================================================

# Entorno
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
REQUEST_TIMEOUT_MS=30000
JSON_BODY_LIMIT=100kb

# CORS — orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173

# JWT (RS256 — claves asimétricas)
# Genera el par con: npm run keys:gen   (deja los archivos en backend/keys/)
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=ironcore-api
JWT_AUDIENCE=ironcore-web

# Cookies (refresh token)
COOKIE_SECURE=false          # true en producción (HTTPS)
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Google Sign-In (verificación de ID token — no requiere client secret en el backend)
GOOGLE_CLIENT_ID=

# AWS / DynamoDB
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
# Para DynamoDB Local descomentar:
# DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=gym_

# Rate limit
RATE_LIMIT_WINDOW_MS=900000      # 15 min
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=5            # 5 intentos/15min en /auth/login

# Logging
LOG_LEVEL=info

# Recordatorio de pago por WhatsApp (SofIA Messenger API) — todo opcional.
# Sin URL/llave/plantillas el backend arranca igual y la función queda apagada.
# Estas variables son solo de conexión: el ENVÍO se enciende/apaga en
# Backoffice → Mensajería (arranca apagado). Ver docs/RECORDATORIO_PAGO.md
MENSAJERO_URL=                    # base del mensajero, p. ej. https://<host> (con o sin /v1)
MENSAJERO_API_KEY=                # msk_… (POST /v1/admin/clients del mensajero)
MENSAJERO_WEBHOOK_SECRET=         # webhookSecret de esa misma app
MENSAJERO_CANAL=default           # vacío = canal por defecto de la app
# Plantillas con botón "Pagar ahora" → https://iron-core.mx/pagar/{{1}} (las de sin botón quedaron obsoletas)
RECORDATORIO_PAGO_PLANTILLA_ANTES=ironcore_pago_por_vencer_liga
RECORDATORIO_PAGO_PLANTILLA_HOY=ironcore_pago_vence_hoy_liga
RECORDATORIO_PAGO_PLANTILLA_DESPUES=ironcore_pago_vencido_liga
RECORDATORIO_PAGO_IDIOMA=es_MX
RECORDATORIO_PAGO_ETAPAS=-3,0,3   # días relativos al vencimiento (negativo = antes)
RECORDATORIO_PAGO_HORA=09:00      # HH:MM, hora de México
# Secreto (≥32 caracteres aleatorios) con el que se firman las ligas /pagar/<token> del botón.
# Sin él NO se envían recordatorios (nunca un botón roto). Cambiarlo invalida las ligas ya enviadas.
LIGA_PAGO_SECRET=
# WhatsApp "pago recibido" tras cada pago exitoso (mismo interruptor de Backoffice → Mensajería)
PAGO_RECIBIDO_PLANTILLA=ironcore_pago_recibido

# Pago en línea con Mercado Pago (Checkout Pro) — todo opcional; sin esto el botón de pagar no aparece.
# Ver docs/PAGO_EN_LINEA.md. NUNCA poner el token ni el secreto con prefijo VITE_.
MERCADOPAGO_ACCESS_TOKEN=         # Access Token (Tus integraciones → Credenciales)
MERCADOPAGO_WEBHOOK_SECRET=       # Clave secreta de Webhooks (Tus integraciones → Webhooks)
PUBLIC_API_URL=                   # URL pública HTTPS del backend (sin /api/v1), para notification_url
PUBLIC_FRONTEND_URL=              # URL pública HTTPS del frontend (producción: https://iron-core.mx)
MERCADOPAGO_STATEMENT_DESCRIPTOR= # opcional, ≤13 caracteres (por defecto IRONCORE GYM)

# Credenciales de Mercado Pago desde Backoffice → Mercado Pago (opcional). Las guardadas ahí van
# cifradas (AES-256-GCM) con esta llave y tienen prioridad sobre MERCADOPAGO_ACCESS_TOKEN/_WEBHOOK_SECRET.
# 32 bytes aleatorios en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin ella no se pueden guardar desde el Backoffice. Si se pierde o se cambia, las guardadas quedan
# ilegibles (Mercado Pago se apaga hasta volver a capturarlas). Guárdala también fuera del servidor.
CREDENCIALES_LLAVE_MAESTRA=
# Código de un solo uso por WhatsApp al teléfono del administrador (plantilla de AUTENTICACIÓN de Meta)
OTP_PLANTILLA=ironcore_codigo_verificacion
OTP_IDIOMA=es_MX
