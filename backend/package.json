{
  "name": "ironcore-backend",
  "version": "1.0.0",
  "description": "IronCore API — Express + DynamoDB + JWT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:create": "node src/scripts/createTables.js",
    "db:seed": "node src/scripts/seed.js",
    "db:import:workbook": "node src/scripts/importWorkbook.js",
    "db:import:members": "node src/scripts/importMembers.js",
    "db:import:gastos": "node src/scripts/importGastos.js",
    "db:import:ingresos": "node src/scripts/importIngresos.js",
    "db:import:inscripciones": "node src/scripts/importInscripciones.js",
    "db:dedupe:clientes": "node src/scripts/dedupeClientes.js",
    "db:backfill:mensualidad": "node src/scripts/backfillClienteMensualidad.js",
    "db:clear-seed": "node src/scripts/clearSeed.js",
    "db:reset": "node src/scripts/createTables.js --recreate && node src/scripts/seed.js",
    "keys:gen": "node src/scripts/generateKeys.js",
    "lint": "echo 'Add eslint if needed'",
    "test": "echo 'Add tests with vitest or jest'"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.624.0",
    "@aws-sdk/lib-dynamodb": "^3.624.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^9.14.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
